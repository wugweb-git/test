{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/process-timeline",
  "version": "1.3.0",
  "title": "Process Timeline",
  "category": "wugweb-service",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "autoRegister": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "attributes": {
    "pillar": {
      "type": "string",
      "enum": [
        "strategy",
        "brand",
        "experience",
        "engineering",
        "growth",
        "operations"
      ],
      "default": "strategy"
    },
    "adImage": {
      "type": "string",
      "default": ""
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "backup",
  "description": "Process Timeline — Wugweb block.",
  "viewScript": "file:./view.js",
  "textdomain": "wugweb-kits",
  "keywords": [
    "process",
    "timeline",
    "steps",
    "approach"
  ]
}
