{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/process-timeline",
  "version": "1.2.0",
  "title": "Process Timeline",
  "category": "wugweb",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "autoRegister": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "pillar": {
      "type": "string",
      "enum": [
        "strategy",
        "brand",
        "experience",
        "engineering",
        "growth",
        "operations"
      ],
      "default": "strategy"
    }
  },
  "render": "file:./render.php",
  "style": "wugweb-core-service",
  "icon": "backup",
  "description": "Process Timeline \u2014 Wugweb block."
}