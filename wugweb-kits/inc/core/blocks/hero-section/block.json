{
  "apiVersion": 3,
  "name": "wugweb/hero-section",
  "version": "1.1.0",
  "title": "Hero Section",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Where Vision Meets Velocity"
    },
    "buttonLabel": {
      "type": "string"
    },
    "buttonUrl": {
      "type": "string"
    },
    "secondaryLabel": {
      "type": "string"
    },
    "secondaryUrl": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string"
    },
    "posterUrl": {
      "type": "string"
    }
  },
  "icon": "cover-image",
  "description": "Page hero with eyebrow, headline, intro and button."
}