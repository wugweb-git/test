{
  "apiVersion": 3,
  "name": "wugweb/hero-section",
  "version": "1.3.0",
  "title": "Hero Section",
  "category": "wugweb-layout",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Where Vision Meets Velocity"
    },
    "buttonLabel": {
      "type": "string"
    },
    "buttonUrl": {
      "type": "string"
    },
    "secondaryLabel": {
      "type": "string"
    },
    "secondaryUrl": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string"
    },
    "posterUrl": {
      "type": "string"
    }
  },
  "icon": "cover-image",
  "description": "Page hero with eyebrow, headline, intro and button.",
  "textdomain": "wugweb-kits",
  "keywords": [
    "hero",
    "banner",
    "intro",
    "headline"
  ]
}
