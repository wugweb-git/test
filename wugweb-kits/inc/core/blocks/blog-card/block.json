{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/blog-card",
  "version": "3.0.0",
  "title": "Blog Card",
  "category": "wugweb-cards",
  "keywords": [
    "card",
    "wugweb"
  ],
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Design"
    },
    "title": {
      "type": "string",
      "default": "Blog post title"
    },
    "text": {
      "type": "string",
      "default": "Short excerpt for the post."
    },
    "meta": {
      "type": "string",
      "default": "5 min read"
    },
    "url": {
      "type": "string",
      "default": "#"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "postId": {
      "type": "integer",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "styles": [
    {
      "name": "default",
      "label": "Card",
      "isDefault": true
    },
    {
      "name": "row",
      "label": "Row (stacked, mobile)"
    }
  ],
  "render": "file:./render.php",
  "style": [
    "wugweb-post-card"
  ],
  "icon": "format-aside",
  "description": "Blog Card — Wugweb block.",
  "usesContext": [
    "postId",
    "postType"
  ],
  "textdomain": "wugweb-kits"
}
