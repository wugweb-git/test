{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/blog-card",
  "version": "1.1.0",
  "title": "Blog Card",
  "category": "wugweb",
  "keywords": [
    "card",
    "wugweb"
  ],
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Design"
    },
    "title": {
      "type": "string",
      "default": "Blog post title"
    },
    "text": {
      "type": "string",
      "default": "Short excerpt for the post."
    },
    "meta": {
      "type": "string",
      "default": "5 min read"
    },
    "url": {
      "type": "string",
      "default": "#"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "styles": [
    {
      "name": "default",
      "label": "Default",
      "isDefault": true
    },
    {
      "name": "compact",
      "label": "Compact"
    },
    {
      "name": "row",
      "label": "Row"
    }
  ],
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "format-aside",
  "description": "Blog Card \u2014 Wugweb block."
}