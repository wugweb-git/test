{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/section-intro",
  "version": "1.3.0",
  "title": "Section Intro",
  "category": "wugweb",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "autoRegister": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "attributes": {
    "variant": {
      "type": "string",
      "enum": [
        "intro",
        "why"
      ],
      "default": "intro"
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "heading",
  "description": "Heading + paragraph band (services/index.astro .services-intro and .why-wugweb)."
}