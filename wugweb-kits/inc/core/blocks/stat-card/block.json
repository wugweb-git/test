{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/stat-card",
  "version": "1.3.0",
  "title": "Stat Card",
  "category": "wugweb",
  "keywords": [
    "card",
    "wugweb"
  ],
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "306%"
    },
    "title": {
      "type": "string",
      "default": "Higher lifetime value"
    },
    "text": {
      "type": "string",
      "default": "For emotionally connected brands."
    },
    "meta": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "styles": [
    {
      "name": "default",
      "label": "Default",
      "isDefault": true
    },
    {
      "name": "compact",
      "label": "Compact"
    },
    {
      "name": "row",
      "label": "Row"
    }
  ],
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "chart-line",
  "description": "Stat Card \u2014 Wugweb block."
}