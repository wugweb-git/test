{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/stat-card",
  "version": "1.0.0",
  "title": "Stat Card",
  "category": "design",
  "keywords": [
    "card",
    "wugweb"
  ],
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "306%"
    },
    "title": {
      "type": "string",
      "default": "Higher lifetime value"
    },
    "text": {
      "type": "string",
      "default": "For emotionally connected brands."
    },
    "meta": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "autoRegister": true
  },
  "styles": [
    {
      "name": "default",
      "label": "Default",
      "isDefault": true
    },
    {
      "name": "compact",
      "label": "Compact"
    },
    {
      "name": "row",
      "label": "Row"
    }
  ],
  "render": "file:./render.php",
  "style": "wugweb-core-cards"
}