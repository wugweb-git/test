{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/stat-card",
  "version": "1.5.0",
  "title": "Stat Card",
  "category": "wugweb-cards",
  "keywords": [
    "stat",
    "counter",
    "number",
    "count up",
    "value",
    "metric"
  ],
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "306%"
    },
    "title": {
      "type": "string",
      "default": "Higher lifetime value"
    },
    "text": {
      "type": "string",
      "default": "For emotionally connected brands."
    },
    "meta": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "metric": {
      "type": "string",
      "default": ""
    },
    "foundedYear": {
      "type": "integer",
      "default": 2020
    }
  },
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "styles": [
    {
      "name": "default",
      "label": "Light (services)",
      "isDefault": true
    },
    {
      "name": "dark",
      "label": "Dark (about counters)"
    },
    {
      "name": "value",
      "label": "Value card"
    }
  ],
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "chart-line",
  "description": "Stat / counter / value card. Styles: Light (services), Dark (about), Value. Number counts up with GSAP; metric pulls a live count (years, projects, industries, clients).",
  "viewScript": "file:./view.js",
  "textdomain": "wugweb-kits"
}
