{
  "apiVersion": 3,
  "name": "wugweb/stats-section",
  "version": "1.0.0",
  "title": "Stats Counter",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "chart-bar",
  "description": "Animated count-up stats (GSAP ScrollTrigger): editable numbers and labels, optional live counts from WordPress, dark (about) or light (services) cards.",
  "attributes": {
    "variant": {
      "type": "string",
      "default": "dark"
    },
    "live": {
      "type": "boolean",
      "default": false
    },
    "foundedYear": {
      "type": "integer",
      "default": 2020
    },
    "items": {
      "type": "array",
      "default": [
        {
          "n": "6+",
          "label": "Years of experience",
          "copy": "Expertise that drives meaningful results."
        },
        {
          "n": "44+",
          "label": "Projects delivered",
          "copy": "Creative solutions built with purpose."
        },
        {
          "n": "42+",
          "label": "Industries served",
          "copy": "Sector fluency built case by case."
        },
        {
          "n": "127+",
          "label": "Brands transformed",
          "copy": "From strategy to standout visuals."
        }
      ]
    }
  },
  "keywords": [
    "stats",
    "counter",
    "numbers",
    "count up",
    "graphical",
    "about",
    "services"
  ],
  "viewScript": "file:./view.js"
}