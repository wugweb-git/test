{
  "apiVersion": 3,
  "name": "wugweb/marquee",
  "version": "1.3.0",
  "title": "Wugweb Logo Marquee",
  "category": "wugweb",
  "icon": "slides",
  "description": "Accessible pauseable text/logo track.",
  "render": "file:./render.php",
  "style": "file:./style.css",
  "viewScriptModule": "file:./view.js",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "interactivity": true,
    "autoRegister": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "attributes": {}
}