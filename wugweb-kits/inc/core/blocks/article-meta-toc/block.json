{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/article-meta-toc",
  "version": "1.6.0",
  "title": "Article Meta & Contents",
  "category": "wugweb-blog-work",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "list-view",
  "description": "Article Meta & Contents — Wugweb block.",
  "attributes": {
    "postId": {
      "type": "integer",
      "default": 0
    }
  },
  "viewScript": "file:./view.js",
  "usesContext": [
    "postId",
    "postType"
  ],
  "textdomain": "wugweb-kits",
  "keywords": [
    "article",
    "table of contents",
    "toc",
    "meta",
    "reading time"
  ]
}
