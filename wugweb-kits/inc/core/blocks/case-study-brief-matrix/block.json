{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/case-study-brief-matrix",
  "version": "1.7.0",
  "title": "Case Study Brief Matrix",
  "category": "wugweb-blog-work",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "editor-table",
  "description": "Case Study Brief Matrix — Wugweb block.",
  "attributes": {
    "postId": {
      "type": "integer",
      "default": 0
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "textdomain": "wugweb-kits",
  "keywords": [
    "case study",
    "brief",
    "matrix",
    "details"
  ]
}
