{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/service-tags",
  "version": "1.3.0",
  "title": "Service Tags",
  "category": "wugweb-service",
  "icon": "tag",
  "description": "The six Wugweb service pillars as coloured tags.",
  "attributes": {
    "heading": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "buttonLabel": {
      "type": "string"
    },
    "buttonUrl": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "viewScript": "file:./view.js",
  "textdomain": "wugweb-kits",
  "keywords": [
    "service",
    "tags",
    "keywords",
    "topics"
  ]
}
