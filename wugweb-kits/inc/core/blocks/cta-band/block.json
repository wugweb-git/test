{
  "apiVersion": 3,
  "name": "wugweb/cta-band",
  "version": "2.0.0",
  "title": "Yellow CTA Box",
  "category": "wugweb-layout",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "megaphone",
  "description": "The yellow call-to-action box above the footer (FooterCTA): heading, copy, button and draggable social discs.",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": "We speak your Industry's language."
    },
    "text": {
      "type": "string",
      "default": "Partner with Wugweb for domain-driven design and development that delivers."
    },
    "buttonLabel": {
      "type": "string",
      "default": "Request Quote"
    },
    "buttonUrl": {
      "type": "string",
      "default": "/contact-us/"
    },
    "discs": {
      "type": "array",
      "default": [
        {
          "platform": "Facebook",
          "profileUrl": "https://www.facebook.com/wugweb"
        },
        {
          "platform": "Instagram",
          "profileUrl": "https://www.instagram.com/wugweb"
        },
        {
          "platform": "Pinterest",
          "profileUrl": "https://in.pinterest.com/wugweb"
        },
        {
          "platform": "X",
          "profileUrl": "https://twitter.com/the_wugweb"
        },
        {
          "platform": "YouTube",
          "profileUrl": "https://www.youtube.com/channel/UC7qGSNvbvZqxZI8cA-Fijlg"
        }
      ]
    },
    "laptopUrl": {
      "type": "string",
      "default": ""
    },
    "mobileUrl": {
      "type": "string",
      "default": ""
    }
  },
  "keywords": [
    "yellow",
    "cta",
    "call to action",
    "band",
    "footer cta",
    "contact",
    "banner",
    "box"
  ],
  "viewScript": "file:./view.js",
  "textdomain": "wugweb-kits"
}
