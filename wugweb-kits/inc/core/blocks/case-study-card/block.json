{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/case-study-card",
  "version": "2.0.0",
  "title": "Case Study Card",
  "category": "wugweb-cards",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "id-alt",
  "description": "Case Study Card — Wugweb block.",
  "attributes": {
    "postId": {
      "type": "integer",
      "default": 0
    },
    "layout": {
      "type": "string",
      "default": "related"
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "next": {
      "type": "boolean",
      "default": false
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "viewScript": "file:./view.js",
  "textdomain": "wugweb-kits",
  "keywords": [
    "case study",
    "work",
    "card",
    "project"
  ]
}
