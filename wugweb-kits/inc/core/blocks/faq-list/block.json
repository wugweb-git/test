{
  "apiVersion": 3,
  "name": "wugweb/faq-list",
  "version": "1.1.0",
  "title": "FAQ List",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    },
    "lede": {
      "type": "string",
      "default": ""
    }
  },
  "icon": "editor-help",
  "description": "Accordion of questions and answers.",
  "viewScript": "file:./view.js"
}