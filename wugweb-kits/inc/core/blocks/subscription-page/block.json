      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {},
  "icon": "money-alt",
  "description": "Subscription page body (footer/subscription.astro). The mock checkout modal is not ported; Start subscription links to contact.",
  "viewScript": "file:./view.js"
