{
  "apiVersion": 3,
  "name": "wugweb/subscription-page",
  "version": "3.0.0",
  "title": "Subscription Page",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
