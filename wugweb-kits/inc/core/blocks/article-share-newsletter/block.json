{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/article-share-newsletter",
  "version": "1.3.0",
  "title": "Article Share & Newsletter",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "share",
  "description": "Share row and newsletter signup for articles. Optionally set a Fluent Forms ID to replace the built-in form.",
  "attributes": {
    "formId": {
      "type": "integer",
      "default": 0
    }
  },
  "viewScript": "file:./view.js"
}