{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/article-share-newsletter",
  "version": "1.2.0",
  "title": "Article Share & Newsletter",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "share",
  "description": "Share row and newsletter signup for articles. Optionally set a Fluent Forms ID to replace the built-in form.",
  "attributes": {
    "formId": {
      "type": "integer",
      "default": 0
    }
  },
  "viewScript": "file:./view.js"
}
