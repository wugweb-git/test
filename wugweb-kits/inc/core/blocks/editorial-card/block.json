{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/editorial-card",
  "version": "3.0.0",
  "title": "Editorial Card",
  "category": "wugweb-cards",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": [
    "wugweb-post-card"
  ],
  "icon": "format-aside",
  "description": "Editorial Card — Wugweb block.",
  "attributes": {
    "postId": {
      "type": "integer",
      "default": 0
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "styles": [
    {
      "name": "default",
      "label": "Card",
      "isDefault": true
    },
    {
      "name": "row",
      "label": "Row (stacked, mobile)"
    }
  ],
  "textdomain": "wugweb-kits",
  "keywords": [
    "editorial",
    "article",
    "card",
    "feature"
  ]
}
