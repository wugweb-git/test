{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/service-stack",
  "version": "1.3.0",
  "title": "Service Stack",
  "category": "wugweb",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "autoRegister": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "attributes": {
    "panels": {
      "type": "array",
      "default": []
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "layout",
  "description": "Sticky stack of the six service panels with tier tabs and work gallery (services/index.astro).",
  "viewScript": "file:./view.js"
}