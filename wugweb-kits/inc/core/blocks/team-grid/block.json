{
  "apiVersion": 3,
  "name": "wugweb/team-grid",
  "version": "1.0.0",
  "title": "Team Grid",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "groups",
  "description": "TeamGrid: two-tone heading and portrait cards for every team member (manual list or WP users).",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "The faces behind the work."
    },
    "headingLead": {
      "type": "integer",
      "default": 2
    },
    "suffix": {
      "type": "string",
      "default": "at wugweb"
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "members": {
      "type": "array",
      "default": [
        {
          "name": "Vedanshu Srivastava",
          "role": "Founder",
          "photo": ""
        },
        {
          "name": "Praneet Verma",
