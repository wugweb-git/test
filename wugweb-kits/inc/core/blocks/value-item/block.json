{
  "apiVersion": 3,
  "name": "wugweb/value-item",
  "version": "1.0.0",
  "title": "Value Item",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "star-filled",
  "description": "A single value card (about page values): number, title, description.",
  "attributes": {
    "n": {
      "type": "string",
      "default": "01"
    },
    "title": {
      "type": "string",
      "default": "Bold"
    },
    "copy": {
      "type": "string",
      "default": "We balance distinctive expression with measurable results."
    }
  },
  "keywords": [
    "value",
    "values",
    "about",
    "card"
  ]
}