{
  "apiVersion": 3,
  "name": "wugweb/case-study-post",
  "version": "1.0.0",
  "title": "Case Study Post",
  "category": "wugweb",
  "supports": { "html": false, "autoRegister": true, "anchor": true, "align": ["wide", "full"] },
