{
  "apiVersion": 3,
  "name": "wugweb/overlay",
  "version": "1.0.1",
  "title": "Overlay (modal / drawer)",
  "category": "wugweb",
  "icon": "welcome-widgets-menus",
  "description": "Reusable native <dialog> overlay: modal, side drawers, bottom drawer or bottom banner. Open it from any button or link with data-overlay-target=\"<anchor>\" or a #anchor link.",
  "supports": {
    "html": false,
    "anchor": true,
    "color": { "background": true, "text": true },
    "spacing": { "padding": true, "blockGap": true },
    "__experimentalBorder": { "radius": true, "color": true, "width": true, "style": true },
    "shadow": true,
    "typography": { "fontSize": true }
  },
  "attributes": {
    "layout": { "type": "string", "enum": ["modal", "drawer-right", "drawer-left", "drawer-bottom", "banner-bottom"], "default": "modal" },
    "title": { "type": "string", "default": "Overlay title" },
    "closeLabel": { "type": "string", "default": "Close" },
    "backdropClose": { "type": "boolean", "default": true },
    "openOnLoad": { "type": "boolean", "default": false }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "viewScript": "file:./view.js",
  "editorScript": "file:./edit.js"
}
