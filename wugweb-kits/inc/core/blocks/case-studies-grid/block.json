{
  "apiVersion": 3,
  "name": "wugweb/case-studies-grid",
  "version": "1.1.0",
  "title": "Portfolio Grid",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Work that Leads with Clarity and Delivers with Impact"
    },
    "buttonLabel": {
      "type": "string",
      "default": "View case studies"
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "count": {
      "type": "integer",
      "default": 8
    }
  },
  "icon": "portfolio",
  "description": "Latest case studies from the Case Study post type.",
  "viewScript": "file:./view.js"
}