{
  "apiVersion": 3,
  "name": "wugweb/case-studies-grid",
  "version": "1.3.0",
  "title": "Portfolio Grid",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Work that Leads with Clarity and Delivers with Impact"
    },
    "buttonLabel": {
      "type": "string",
      "default": "View case studies"
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "count": {
      "type": "integer",
      "default": 8
    }
  },
  "icon": "portfolio",
  "description": "Latest case studies from the Case Study post type.",
  "viewScript": "file:./view.js"
}