{
  "apiVersion": 3,
  "name": "wugweb/blog-index",
  "version": "3.0.0",
  "title": "Blog Index",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": [
    "wugweb-post-card",
    "file:./style.css"
  ],
  "attributes": {
    "limit": {
      "type": "integer",
      "default": 200
    }
  },
  "icon": "grid-view",
  "description": "Featured post, topic filter chips and the post grid (blog/index.astro).",
  "viewScript": "file:./view.js"
}