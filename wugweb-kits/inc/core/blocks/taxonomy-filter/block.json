{
  "apiVersion": 3,
  "name": "wugweb/taxonomy-filter",
  "version": "1.2.0",
  "title": "Wugweb Taxonomy Filter",
  "category": "wugweb",
  "icon": "filter",
  "description": "Accessible case-study discipline and industry filters.",
  "render": "file:./render.php",
  "style": "file:./style.css",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "taxonomy": {
      "type": "string",
      "default": "discipline",
      "enum": [
        "discipline",
        "category",
        "post_tag"
      ]
    }
  }
}
