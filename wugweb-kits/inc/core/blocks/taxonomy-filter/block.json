{
  "apiVersion": 3,
  "name": "wugweb/taxonomy-filter",
  "version": "1.3.0",
  "title": "Wugweb Taxonomy Filter",
  "category": "wugweb-content",
  "icon": "filter",
  "description": "Accessible case-study discipline and industry filters.",
  "render": "file:./render.php",
  "style": "file:./style.css",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "attributes": {
    "taxonomy": {
      "type": "string",
      "default": "discipline",
      "enum": [
        "discipline",
        "category",
        "post_tag"
      ]
    }
  },
  "textdomain": "wugweb-kits",
  "keywords": [
    "filter",
    "taxonomy",
    "categories",
    "chips"
  ]
}
