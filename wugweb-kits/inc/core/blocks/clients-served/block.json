{
  "apiVersion": 3,
  "name": "wugweb/clients-served",
  "version": "1.1.0",
  "title": "Client Logos",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Trusted by"
    },
    "headingAccent": {
      "type": "string",
      "default": "leading brands"
    }
  },
  "icon": "groups",
  "description": "Clients served section."
}