{
  "apiVersion": 3,
  "name": "wugweb/clients-served",
  "version": "1.3.0",
  "title": "Client Logos",
  "category": "wugweb-content",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Trusted by"
    },
    "headingAccent": {
      "type": "string",
      "default": "leading brands"
    }
  },
  "icon": "groups",
  "description": "Clients served section.",
  "textdomain": "wugweb-kits",
  "keywords": [
    "clients",
    "logos",
    "customers",
    "trust"
  ]
}
