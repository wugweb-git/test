{
  "apiVersion": 3,
  "name": "wugweb/about-section",
  "version": "3.0.0",
  "title": "About Section",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "section": {
      "type": "string",
      "enum": [
        "culture",
        "reviews",
        "stats",
        "values"
      ],
      "default": "culture"
    }
  },
  "icon": "groups",
  "description": "About page bands: Culture Reigns Supreme and the reviews teaser (about.astro)."
}
