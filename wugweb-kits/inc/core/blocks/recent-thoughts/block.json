{
  "apiVersion": 3,
  "name": "wugweb/recent-thoughts",
  "version": "3.0.0",
  "title": "Recent Blog Posts",
  "category": "wugweb-blog-work",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": [
    "wugweb-post-card",
    "file:./style.css"
  ],
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Thoughts on design, product, and strategy"
    },
    "buttonLabel": {
      "type": "string",
      "default": "View all articles"
    },
    "buttonUrl": {
      "type": "string",
      "default": "/blog/"
    },
    "count": {
      "type": "integer",
      "default": 4
    },
    "category": {
      "type": "string",
      "default": ""
    }
  },
  "icon": "admin-post",
  "description": "Latest blog posts.",
  "textdomain": "wugweb-kits",
  "keywords": [
    "recent",
    "posts",
    "blog",
    "teaser",
    "insights"
  ]
}
