{
  "apiVersion": 3,
  "name": "wugweb/pillar-scope",
  "version": "1.3.0",
  "title": "Wugweb 6-Pillar Switcher & Scope Selector",
  "category": "wugweb-layout",
  "icon": "grid-view",
  "description": "Interactive service pillar and scope selector.",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "interactivity": true,
    "autoRegister": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "attributes": {
    "ctaUrl": {
      "type": "string",
      "default": "#"
    }
  },
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js",
  "style": "file:./style.css",
  "textdomain": "wugweb-kits",
  "keywords": [
    "pillars",
    "services",
    "switcher",
    "scope"
  ]
}
