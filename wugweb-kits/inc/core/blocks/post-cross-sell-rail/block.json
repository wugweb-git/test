{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/post-cross-sell-rail",
  "version": "3.0.0",
  "title": "Post Cross-Sell Rail",
  "category": "wugweb-blog-work",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": [
    "wugweb-post-card",
    "file:./style.css"
  ],
  "icon": "networking",
  "description": "Post Cross-Sell Rail — Wugweb block.",
  "attributes": {
    "postId": {
      "type": "integer",
      "default": 0
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "textdomain": "wugweb-kits",
  "keywords": [
    "related",
    "posts",
    "rail",
    "cross-sell"
  ]
}
