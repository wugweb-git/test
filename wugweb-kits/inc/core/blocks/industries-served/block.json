{
  "apiVersion": 3,
  "name": "wugweb/industries-served",
  "version": "1.3.0",
  "title": "Industries Served",
  "category": "wugweb-content",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "We understand the context behind the product."
    },
    "intro": {
      "type": "string",
      "default": "From regulated sectors to fast-moving consumer markets, our experience spans industries that demand precision and creativity in equal measure."
    },
    "buttonLabel": {
      "type": "string",
      "default": "Explore All Industries"
    },
    "buttonUrl": {
      "type": "string",
      "default": "/industries/"
    }
  },
  "icon": "building",
  "description": "Industries served section.",
  "textdomain": "wugweb-kits",
  "keywords": [
    "industries",
    "sectors",
    "served",
    "showcase"
  ]
}
