{
  "apiVersion": 3,
  "name": "wugweb/legal-hub",
  "version": "3.0.0",
  "title": "Legal Hub",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {
    "active": {
      "type": "string",
      "enum": [
        "privacy-policy",
        "terms-of-use",
        "refund-policy",
        "cookie-policy"
      ],
      "default": "privacy-policy"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "updated": {
      "type": "string",
      "default": ""
    }
  },
  "icon": "privacy",
  "description": "Legal pages chrome: breadcrumb, title, updated date, legal nav and content column (layouts/LegalLayout.astro). Wrap the policy text in it.",
  "viewScript": "file:./view.js"
}