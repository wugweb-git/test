{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/service-impact-bento",
  "version": "1.2.0",
  "title": "Service Impact Bento",
  "category": "wugweb",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "autoRegister": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "pillar": {
      "type": "string",
      "enum": [
        "strategy",
        "brand",
        "experience",
        "engineering",
        "growth",
        "operations"
      ],
      "default": "strategy"
    },
    "mediaImage": {
      "type": "string",
      "default": ""
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "icon": "layout",
  "description": "Service Impact Bento — Wugweb block.",
  "viewScript": "file:./view.js"
}