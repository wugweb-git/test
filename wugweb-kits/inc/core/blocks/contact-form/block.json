{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/contact-form",
  "version": "1.0.0",
  "title": "Contact Form",
  "category": "wugweb",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php",
  "style": "wugweb-core-content",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Tell us what you are building."
    },
    "formId": {
      "type": "integer",
      "default": 0
    }
  },
  "icon": "email",
  "description": "Contact form block (Fluent Forms)."
}