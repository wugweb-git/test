{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wugweb/contact-form",
  "version": "2.0.0",
  "title": "Contact Form",
  "category": "wugweb-pages",
  "supports": {
    "html": false,
    "autoRegister": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "letterSpacing": true,
      "textTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "attributes": {},
  "icon": "email",
  "description": "Contact enquiry form and offices sidebar (native, posts to admin-post.php).",
  "textdomain": "wugweb-kits",
  "keywords": [
    "contact",
    "form",
    "enquiry",
    "message"
  ],
  "viewScript": "file:./view.js"
}